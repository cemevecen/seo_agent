# GSC Core Web Vitals + AMP (03:00 + 15:00 TR → /web-vitals):
# GSC_CWV_INGEST_URL=https://projectcontrol.up.railway.app/api/gsc-cwv/ingest
# GSC_CWV_BRIDGE_MINUTE=0
# GSC_CWV_BRIDGE_TIMEOUT_SEC=7200
# GSC_CWV_PROFILE_DIR=~/.seo-agent/play-console-profile
