# POLICY_NOADS_EMAIL_COOLDOWN_HOURS=6
# POLICY_NOADS_ALARM_MIN_MISSING=15
# POLICY_NOADS_ALARM_MIN_AD_REQUESTS=500
# SEO audit Mac bridge scrape (GA4 top 500, 02:45 + 14:45 TR → /seo-audit):
# SEO_AUDIT_SCRAPE_PRIMARY=true
# SEO_AUDIT_TOP_LIMIT=500
# SEO_AUDIT_SITE_IDS=1,2
# SEO_AUDIT_BRIDGE_MINUTE=45
# SEO_AUDIT_BRIDGE_TIMEOUT_SEC=5400
# SEO_AUDIT_API_BASE=https://projectcontrol.up.railway.app
# Bridge: POST http://127.0.0.1:18765/sync-seo-audit  body {"site_id":1}
