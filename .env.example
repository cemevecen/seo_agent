# Sync:   .venv/bin/python scripts/gsc_cwv_scrape.py --sync --ingest --headed
# (aynı Google profil: PLAY_CONSOLE_PROFILE_DIR / cemevecen@nokta.com)
# PLAY_CONSOLE_PROFILE_DIR=~/.seo-agent/play-console-profile
# PLAY_CONSOLE_BRIDGE_INTERVAL_SEC=10800
# ASC_CONSOLE_BRIDGE_INTERVAL_SEC=10800
# (slot: play :00 / asc :05 every 3h; gsc/policy/speed/noads 01:xx+13:xx)
# App Store Connect scrape (Mac bridge — Android Play ile aynı token)
# ASC_CONSOLE_INGEST_URL=https://projectcontrol.up.railway.app/api/asc-console/ingest
# ASC_CONSOLE_PROFILE_DIR=~/.seo-agent/asc-console-profile
# ASC_CONSOLE_APP_ID=465599322
# ASC_CONSOLE_BUNDLE_ID=com.nokta.Finans.Takip
# ASC_CONSOLE_SCRAPE_DAYS=365
# Firebase Console Crashlytics scrape → /s-firebase (Android + iOS)
# FIREBASE_CONSOLE_INGEST_URL=https://projectcontrol.up.railway.app/api/firebase-console/ingest
# FIREBASE_CONSOLE_PROFILE_DIR=~/.seo-agent/firebase-console-profile
# FIREBASE_CONSOLE_SCRAPE_DAYS=365
# FIREBASE_CONSOLE_BRIDGE_MINUTE=10
# FIREBASE_CONSOLE_HEADLESS=0
# Bridge: POST http://127.0.0.1:18765/sync-asc
# Login:  .venv/bin/python scripts/asc_console_scrape.py --login
# Sync:   .venv/bin/python scripts/asc_console_scrape.py --sync --ingest

# Vitals crashes filtre: sürüm kodu (ör. 290) — boşsa tüm sürümler
# PLAY_CONSOLE_VITALS_VERSION_CODE=290
# Son 3 sürüm (virgülle) — boşsa VERSION_CODE’dan CODE, CODE-1, CODE-2 üretilir
# PLAY_CONSOLE_VITALS_VERSION_CODES=290,289,288
# Genel kategoriden kaç sorun detay sayfası çekilsin (0–40)
# PLAY_CONSOLE_VITALS_DETAIL_LIMIT=40
# Yorumlar: geriye dönük gün (varsayılan 365) ve üst sınır
# PLAY_CONSOLE_REVIEWS_DAYS=365
# PLAY_CONSOLE_REVIEWS_MAX=2500
# Reach and devices dashboard (peerset + URL override)
# PLAY_CONSOLE_DEVICES_PEERSET=3%3A6a1f18dbb44333cd
# PLAY_CONSOLE_DEVICES_URL=https://play.google.com/console/u/0/developers/.../app/.../devices/dashboard?days=28&peerset_key=...&expanded_breakdowns=ANDROID_VERSION
#
# Interaktif /android keşif paneli (GCS Play raporları — tarih/kırılım):
# GP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Play Console → Kullanıcılar ve izinler → service account ekle:
#   - "Uygulama bilgilerini görüntüleme (salt okunur)"  (vitals / Reporting)
#   - "Mali verileri görüntüleme" (isteğe bağlı gelir)
# Google Cloud’da Play Developer Reporting API’yi etkinleştir.
# GP_REPORTS_BUCKET=pubsite_prod_rev_XXXXXXXX
# GP_PACKAGE_NAME=com.Doviz
# (opsiyonel eski stil) her N. bildirim turunda haber; set edilirse INTERVAL yerine kullanılır:
# PM lab SERP — 4×5 kelime, 15 dk arayla (Mac bridge headed Firefox)
# PM_LAB_SERP_CYCLE_HOURS=3,6,9,12,15,18,21
# PM_LAB_SERP_BATCH_MINUTES=50,5,20,35
# PM_LAB_SERP_BATCH_GAP_SEC=900
# PM_LAB_SLOT_HOURS=1,4,7,10,13,16,19,22
# PM_LAB_SLOT_MINUTE=54
# PM_LAB_COMPETITORS_SLOT_MINUTES=24,34,44,54
# BRIDGE_SCRAPE_MIN_GAP_SEC=180
# BRIDGE_SLOT_WINDOW_MIN=35
# PLAY_CONSOLE_BRIDGE_MINUTE=2
# ASC_CONSOLE_BRIDGE_MINUTE=11
# VIRGUL_BRIDGE_MINUTE=8
# PM_LAB_SERP_PAGE_SLEEP_SEC=3.5
# PM_LAB_SERP_KEYWORD_SLEEP_SEC=5.0
# PM_LAB_AUTO_INTERVAL_SEC=10800
# DOVIZ_ADMIN_NEWS_DIRECT_SCRAPE=false
# DOVIZ_ADMIN_SHEET_FALLBACK_ENABLED=false
# DOVIZ_ADMIN_NOTIFICATION_SYNC_ENABLED=true
# CSV manifest (panelden yükleme → DB → saatlik tarama)
# DOVIZ_ASSET_CSV_MANIFEST_ENABLED=true
# DOVIZ_ASSET_CSV_MANIFEST_INTERVAL_MINUTES=60
# DOVIZ_ASSET_CSV_MANIFEST_WORKERS=10
# DOVIZ_ASSET_CSV_MANIFEST_FETCH_TIMEOUT=15
# DOVIZ_ASSET_CSV_MANIFEST_MAX_EMAILS_PER_ISSUE=2

# ── Kota / Rate limiting ──────────────────────────────────────────────────────
QUOTA_GUARD_ENABLED=true
QUOTA_WARNING_RATIO=0.8
PAGESPEED_DAILY_LIMIT=80
PAGESPEED_MONTHLY_LIMIT=1500
# Data Explorer ve tam site manuel yenilemede günlük/aylık kota sayacını atla (Google API yine tüketilir). false = kota dolunca 429.
PAGESPEED_MANUAL_REFRESH_BYPASS_QUOTA=true
PAGESPEED_REQUEST_TIMEOUT=75
PAGESPEED_MAX_RETRIES=2
PAGESPEED_RETRY_BACKOFF_SECONDS=2.0
SEARCH_CONSOLE_DAILY_LIMIT=80
SEARCH_CONSOLE_MONTHLY_LIMIT=1500

# ── App Store Connect API (/app → App Store Connect paneli) ─────────────────
# Users and Access → Keys → App Store Connect API (JWT .p8 içeriği tek satır veya \\n ile)
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Sales & Trends indirme/gelir için Payments and Financial Reports → Vendor Number
# ASC_VENDOR_NUMBER=
# Analytics Reports: Sales and Reports veya Admin rolü; ONGOING istek ilk kez 1–2 gün sürebilir

# ── App Intel (Play kategori sırası) ───────────────────────────────────────────
# Play headless çoğu ortamda ~50–75 uygulama sonrası durur; doğrulanmış sıra için (ör. mağaza ekranı):
# APP_INTEL_ANDROID_RANK_OVERRIDES={"doviz":161}
# Railway’de tam otomatik sıra için: APP_INTEL_ALLOW_PLAYWRIGHT_ON_RAILWAY=1 (süre maliyeti)

# ── Live refresh (uptime ping + otomatik sayfa yükü ölçümleri) ───────────────
# false iken: otomatik dashboard/site-detail PageSpeed tetikleri kapalı kalır;
# manuel "PSI + CrUX Yenile" ve POST /api/site/.../refresh (force) yine PageSpeed toplar.
LIVE_REFRESH_ENABLED=true
LIVE_REFRESH_METHOD=GET
LIVE_REFRESH_TIMEOUT=8
LIVE_REFRESH_URLS=http://app:8012/health,http://app:8012/
